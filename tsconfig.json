{
    "compilerOptions": {
      "target": "ESNext",
      "module": "commonjs",
      "moduleResolution": "node",
      "baseUrl": ".",
      "paths": {
        "@config/*": ["config/*"],
        "@core/*": ["src/core/*"],
        "@domain/*": ["src/domain/*"],
        "@infra/*": ["src/infra/*"],
        "@fixtures/*": ["src/core/fixtures/*"],
        "@utils/*": ["src/core/utils/*"]
      },
      "strict": true,
      "noImplicitAny": false,
      "esModuleInterop": true,
      "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "config/**/*.ts", "playwright.config.ts"]
  }